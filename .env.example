# --- Server (packages/server) ---
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spendwise

JWT_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GEMINI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File storage for shared screenshots (pick one)
CLOUDINARY_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Optional
REDIS_URL=

# --- Web (apps/web) ---
# Next.js does not read this root file — copy this block into apps/web/.env.local instead
# (see specifications/07-environment-variables.md).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Mobile (apps/mobile) ---
# `localhost` only works in the iOS Simulator (it shares the Mac's network namespace). A physical
# device running Expo Go resolves `localhost` to itself, not your dev machine — every API call
# fails there. Put your dev machine's LAN IP (`ipconfig getifaddr en0` on macOS) in
# apps/mobile/.env.local instead, e.g. EXPO_PUBLIC_API_URL=http://192.168.1.6:4000/api. Both the
# phone and the dev machine must be on the same network, and the backend must actually be running
# (npm run dev:server).
EXPO_PUBLIC_API_URL=http://localhost:4000/api
